####Set up####
##read in data
dat = read.csv("Ex 3.csv")
##libraries
library(ez)
library(reshape)
library(psychReport)
#turn off scientific notation
options(scipen = 999)
##Descriptives
tapply(dat$Answer, dat$encoding, mean, na.rm = T)
#get ns
term = subset(dat,
dat$encoding == "term")
read = subset(dat,
dat$encoding == "read")
restudy = subset(dat,
dat$encoding == "restudy")
TA = subset(dat,
dat$encoding == "TA")
length(unique(term$ID)) #45
length(unique(read$ID)) #41
length(unique(restudy$ID)) #40
length(unique(TA$ID)) #44
####Analyses####
##one-way between ANOVA
m1 = ezANOVA(data = dat,
dv = Answer,
wid = ID,
between = encoding,
type = 3,
detailed = T)
m1$ANOVA$MSE = m1$ANOVA$SSd/m1$ANOVA$DFd
m1$ANOVA$MSE
aovEffectSize(m1, effectSize = "pes")
###Follow-up testing
##get back in long format
dat.wide = cast(dat, ID ~ encoding, mean)
term2 = dat.wide[ , c(1, 5)]
read2 = dat.wide[ , c(1, 2)]
restudy2 = dat.wide[ ,c(1, 3)]
TA2 = dat.wide[ , c(1, 4)]
sd(term2$term, na.rm = T); sd(read2$read, na.rm = T)
##run the t-testS
#Target Present vs. No-JOL Control
temp = t.test(term2$term, read2$read, paired = F, p.adjust.methods = "bonferroni", var.equal = T)
temp
round(temp$p.value, 3)
temp$statistic
(temp$conf.int[2] - temp$conf.int[1]) / 3.92 #sig!
#Target Present vs Restudy
temp = t.test(term2$term, restudy2$restudy, paired = F, p.adjust.methods = "bonferroni", var.equal = T)
temp
round(temp$p.value, 3)
temp$statistic
(temp$conf.int[2] - temp$conf.int[1]) / 3.92 #sig!
sd(term2$term, na.rm = T); sd(restudy2$restudy, na.rm = T)
#Target Present vs TA
temp = t.test(term2$term, TA2$TA, paired = F, p.adjust.methods = "bonferroni", var.equal = T)
temp
round(temp$p.value, 3)
temp$statistic
(temp$conf.int[2] - temp$conf.int[1]) / 3.92 #sig!
#TA vs NO-JOL
temp = t.test(TA2$TA, read2$read, paired = F, p.adjust.methods = "bonferroni", var.equal = T) #.015
temp
round(temp$p.value, 3)
temp$statistic
(temp$conf.int[2] - temp$conf.int[1]) / 3.92
sd(TA2$TA, na.rm = T); sd(read2$read, na.rm = T)
#TA vs Restudy
temp = t.test(TA2$TA, restudy2$restudy, paired = F, p.adjust.methods = "bonferroni", var.equal = T) #.015
temp
round(temp$p.value, 3)
temp$statistic
(temp$conf.int[2] - temp$conf.int[1]) / 3.92
#Read vs Restudy
temp = t.test(read2$read, restudy2$restudy, paired = F, p.adjust.methods = "bonferroni", var.equal = T) #.015
temp
round(temp$p.value, 3)
temp$statistic
(temp$conf.int[2] - temp$conf.int[1]) / 3.92
pbic1 = read2
pbic2 = restudy2
pbic1$encoding = rep("Read")
pbic2$encoding = rep("restudy")
colnames(pbic1)[2] = "score"
colnames(pbic2)[2] = "score"
pbic3 = rbind(pbic1, pbic2)
pbic3 = na.omit(pbic3)
ezANOVA(pbic3,
dv = score,
wid = ID,
between = encoding,
type =3,
detailed = T)
####get values for 95% CIs####
(sd(term2$term, na.rm = T) / sqrt(nrow(na.omit(term2)))) * 1.96
(sd(TA2$TA, na.rm = T) / sqrt(nrow(na.omit(TA2)))) * 1.96
(sd(restudy2$restudy, na.rm = T) / sqrt(nrow(na.omit(restudy2)))) * 1.96
(sd(read2$read, na.rm = T) / sqrt(nrow(na.omit(read2)))) * 1.96
#so, compared to silent reading, term-specific JOLs greatly increase recognition
pbic1 = TA2
pbic2 = read2
pbic1$encoding = rep("TA")
pbic2$encoding = rep("read")
colnames(pbic1)[2] = "score"
colnames(pbic2)[2] = "score"
pbic3 = rbind(pbic1, pbic2)
pbic3 = na.omit(pbic3)
ezANOVA(pbic3,
dv = score,
wid = ID,
between = encoding,
type =3,
detailed = T)
ezANOVA(pbic3,
dv = score,
wid = ID,
between = encoding,
type =3,
detailed = T)
####HW 7####
set.seed(123)
# Number of participants
n <- 60
# Participant IDs
ID <- 1:n
# Demographics
Age <- round(rnorm(n, mean = 25, sd = 4))  # Random ages around 25
Gender <- sample(c("Male", "Female", "Other"), size = n, replace = TRUE, prob = c(0.45, 0.45, 0.1))
# Simulate scores with decreasing means and some overlap
Score_A <- round(rnorm(n, mean = 85, sd = 5))  # Well-rested
Score_B <- round(rnorm(n, mean = 75, sd = 6))  # Moderate deprivation
Score_C <- round(rnorm(n, mean = 65, sd = 6))  # Severe deprivation
# Add one outlier to Score_B and Score_C
outlier_index <- sample(1:n, 1)
Score_B[outlier_index] <- Score_B[outlier_index] + 25  # High outlier in B
Score_C[outlier_index] <- Score_C[outlier_index] + 25  # High outlier in C
# Assemble into a data frame
df <- data.frame(
ID = ID,
Age = Age,
Gender = Gender,
Score_A = Score_A,
Score_B = Score_B,
Score_C = Score_C
)
# Save to CSV
write.csv(df, "HW 7.csv", row.names = FALSE)
