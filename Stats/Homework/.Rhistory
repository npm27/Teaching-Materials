####HW 2####
set.seed(123)  # for reproducibility
n <- 50  # number of participants
num_items <- 24
# Generate data matrix with values 1-5, approximately normal but rounded
data_matrix <- matrix(
round(pmin(pmax(rnorm(n * num_items, mean = 3.5, sd = 1), 1), 5)),
nrow = n, ncol = num_items
)
# Convert to data frame and assign column names
df <- as.data.frame(data_matrix)
colnames(df) <- paste0("q_", 1:num_items)
# Add participant ID column
df$ID <- 1:n
# Reorder columns to have ID first
df <- df[, c("ID", paste0("q_", 1:num_items))]
# View first few rows
head(df)
# If you want to export to CSV:
#write.csv(df, "HW 2.csv", row.names = FALSE)
####HW 3####
# Set seed for reproducibility
set.seed(42)
# Generate 55 valid social media usage values (0–720 minutes)
social_media_valid <- round(rnorm(55, mean = 180, sd = 60))
social_media_valid <- pmin(pmax(social_media_valid, 0), 720)  # clamp to 0–720
# Generate 55 valid self-esteem scores (10–40 scale)
self_esteem_valid <- round(rnorm(55, mean = 25, sd = 5))
self_esteem_valid <- pmin(pmax(self_esteem_valid, 10), 40)  # clamp to 10–40
# Add 5 invalid/extreme entries
social_media_invalid <- c(800, -50, 7000, 650, 900)
self_esteem_invalid <- c(5, 45, 9, 100, 0)
# Combine valid and invalid data
social_media <- c(social_media_valid, social_media_invalid)
self_esteem <- c(self_esteem_valid, self_esteem_invalid)
# Create participant IDs
participant_id <- sprintf("P%03d", 1:60)
# Build data frame
lab_data <- data.frame(
Participant_ID = participant_id,
Social_Media_Min = social_media,
Self_Esteem_Score = self_esteem
)
# Save to CSV
#write.csv(lab_data, "HW 3.csv", row.names = FALSE)
####HW 4####
set.seed(42)
# Sample size
n_per_group <- 45
total_n <- n_per_group * 2
# Generate participant IDs
Participant_ID <- sprintf("%03d", 1:total_n)
# Group assignment
Group <- c(rep(1, n_per_group), rep(2, n_per_group))  # 1 = Feedback, 2 = No Feedback
# Simulate values
Metamemory_Accuracy <- c(
rnorm(n_per_group, mean = 0.6, sd = 0.15),  # Feedback group
rnorm(n_per_group, mean = 0.3, sd = 0.15)   # No Feedback group
)
Confidence_Mean <- c(
rnorm(n_per_group, mean = 85, sd = 5),  # Feedback group
rnorm(n_per_group, mean = 75, sd = 6)   # No Feedback group
)
Recall_Performance <- c(
rnorm(n_per_group, mean = 80, sd = 7),  # Feedback group
rnorm(n_per_group, mean = 70, sd = 8)   # No Feedback group
)
# Clip Confidence and Recall between 0 and 100
Confidence_Mean <- pmin(pmax(Confidence_Mean, 0), 100)
Recall_Performance <- pmin(pmax(Recall_Performance, 0), 100)
# Add 2 outliers in Metamemory_Accuracy
outlier_indices <- sample(1:total_n, 2)
Metamemory_Accuracy[outlier_indices[1]] <- 2.5   # extreme high outlier
Metamemory_Accuracy[outlier_indices[2]] <- -2.0  # extreme low outlier
# Create data frame
df <- data.frame(
Participant_ID,
Group,
Metamemory_Accuracy = round(Metamemory_Accuracy, 3),
Confidence_Mean = round(Confidence_Mean, 1),
Recall_Performance = round(Recall_Performance, 1)
)
# Write to CSV
#write.csv(df, "HW 4.csv", row.names = FALSE)
####HW 5####
set.seed(2025)  # for reproducibility
# Generate mostly normal data
n <- 34
pre_scores <- rnorm(n - 1, mean = 72, sd = 8)
post_scores <- pre_scores + rnorm(n - 1, mean = 1.5, sd = 6)  # Small mean change
# Add 1 extreme outlier to each variable
pre_outlier <- 40    # Extremely low pre-training score
post_outlier <- 98   # Extremely high post-training score
# Combine scores
Pre_Accuracy <- c(pre_scores, pre_outlier)
Post_Accuracy <- c(post_scores, post_outlier)
ID <- 1:n
# Create data frame
df <- data.frame(ID, Pre_Accuracy, Post_Accuracy)
# Save as CSV
#write.csv(df, "HW 5.csv", row.names = FALSE)
# Check t-test to confirm it's non-significant
#t.test(df$Pre_Accuracy, df$Post_Accuracy, paired = TRUE)
####HW 6####
set.seed(123)  # For reproducibility
# Sample sizes
n <- 30
# Simulated group means and standard deviations
lecture_scores <- rnorm(n, mean = 12, sd = 2.5)
discussion_scores <- rnorm(n, mean = 14, sd = 2.5)
interactive_scores <- rnorm(n, mean = 16, sd = 2.5)
# Introduce one outlier in the discussion group
discussion_scores[5] <- 4  # Obvious outlier
# Combine into a dataframe
Test_Score <- c(lecture_scores, discussion_scores, interactive_scores)
Instruction_Method <- factor(rep(c("Lecture", "Discussion", "Interactive"), each = n))
ID <- 1:90
# Add age and gender for realism
Age <- round(rnorm(90, mean = 21, sd = 2))  # Age 18–25 typical
Gender <- sample(c("Male", "Female", "Other"), 90, replace = TRUE, prob = c(0.45, 0.45, 0.1))
# Create the data frame
data <- data.frame(
ID = ID,
Age = Age,
Gender = Gender,
Instruction_Method = Instruction_Method,
Test_Score = round(Test_Score)  # Scores out of 20, rounded
)
# Cap scores at 0 and 20 to simulate test boundaries
data$Test_Score <- pmin(pmax(data$Test_Score, 0), 20)
#write.csv(data, "HW 6.csv", row.names = FALSE)
options(scipen = 999)
library(ez)
library(reshape)
ezANOVA(data, wid = ID,
between = Instruction_Method,
dv = Test_Score,
type = 3,
detailed = T)
dat.wide = cast(data, ID ~ Instruction_Method, mean)
t.test(dat.wide$Interactive, dat.wide$Lecture, paired = F, var.equal = T)
t.test(dat.wide$Interactive, dat.wide$Discussion, paired = F, var.equal = T)
t.test(dat.wide$Discussion, dat.wide$Lecture, paired = F, var.equal = T)
