term.e3 = na.omit(term2)
temp = t.test(term.e2$term, term.e3$term, paired = F, p.adjust.methods = "bonferroni", var.equal = T)
temp
##get CIs for chart
sd(term2$term)
##get CIs for chart
sd(term2$term, na.rm = T)
##get CIs for chart
sd(term2$term, na.rm = T) / sqrt(nrow(term2))
##get CIs for chart
(sd(term2$term, na.rm = T) / sqrt(nrow(term2))) * 1.96
(sd(read2$read, na.rm = T) / sqrt(nrow(na.omit(read2)))) * 1.96
##get CIs for chart
(sd(term2$term, na.rm = T) / sqrt(nrow(na.omit(term2)))) * 1.96
nrow(na.omit(read2))
