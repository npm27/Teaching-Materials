set.seed(42)
n <- 75
# 1. Simulate data
participant_id <- 1:n
gender <- sample(c(0, 1), n, replace = TRUE)
job_satisfaction <- pmin(pmax(rnorm(n, mean = 7, sd = 1.5), 1), 10)
workload <- pmin(pmax(rnorm(n, mean = 42, sd = 10), 20), 80)
autonomy <- pmin(pmax(rnorm(n, mean = 6, sd = 2), 1), 10)
recognition <- pmin(pmax(rnorm(n, mean = 4, sd = 2), 0), 12)
stress <- pmin(pmax(rnorm(n, mean = 5, sd = 2), 1), 10)
# Generate motivation with gender effect and noise
motivation <- 3 * job_satisfaction - 0.2 * workload + 2 * autonomy +
1.5 * recognition - 2.5 * stress + 5 * gender + rnorm(n, mean = 0, sd = 5)
motivation <- pmin(pmax(motivation, 0), 100)
# 2. Create dataframe
df <- data.frame(
participant_id,
gender,
job_satisfaction = round(job_satisfaction, 2),
workload = round(workload, 1),
autonomy = round(autonomy, 2),
recognition = round(recognition, 2),
stress = round(stress, 2),
motivation = round(motivation, 2)
)
# 3. Introduce missing values (~5% in each relevant column)
introduce_missing <- function(vec, pct = 0.05) {
n_missing <- floor(length(vec) * pct)
indices <- sample(seq_along(vec), n_missing)
vec[indices] <- NA
return(vec)
}
df$job_satisfaction <- introduce_missing(df$job_satisfaction)
df$workload <- introduce_missing(df$workload)
df$autonomy <- introduce_missing(df$autonomy)
df$recognition <- introduce_missing(df$recognition)
df$stress <- introduce_missing(df$stress)
df$motivation <- introduce_missing(df$motivation)
# 4. Introduce a text error in 'recognition'
set.seed(2)
text_error_index <- sample(1:n, 1)
df$recognition[text_error_index] <- "four"
# 5. Introduce an outlier in 'workload'
set.seed(1)
outlier_index <- sample(1:n, 1)
df$workload[outlier_index] <- 120
# 6. Print the full messy dataset (paste into Word)
print(df, row.names = FALSE)
setwd("~/GitHub/Teaching-Materials/Stats/Labs/Lab 9")
write.csv(df, file = "Lab 9.csv", row.names = F)
