####Set up####
##read in data
dat = read.csv("Ex 3 Data.csv")
length(unique(dat$ID)) #90 participants
##libraries
library(ez)
library(reshape)
library(psychReport)
library(stringr)
#turn off scientific notation
options(scipen = 999)
####Data screening####
#JOLs
JOLs_T = read.csv("JOL/ED JOLs 3 Term JOLs.csv")
JOL_T_Wide = cast(JOLs_T, ID ~ encoding, value = "JOL", mean)
#Knowledge check
kc = read.csv("KC/ED JOLs 3 Knowledge Check.csv")
#check knowledge check
colnames(kc)[2:5] = c("DD", "AD", "SO", "SUN")
##screen the recog data
dat.wide = cast(dat, ID ~ encoding, mean)
apply(kc[2:5], 2, mean) #generally low, highest for the sun, lowest for DD
####Descriptives####
tapply(dat$Answer, dat$encoding, mean, na.rm = T)
#drop out the high knowledge participants
dat = subset(dat,
dat$ID != "2003" & dat$ID != "3037")
#any super low/high performers? #3003 is a bit lower than their peers
#what about JOL instrucions? #2036 gave almost all 100'S
dat = subset(dat,
dat$ID != "2036")
##update kc
kc = subset(kc,
kc$ID != "2003" & kc$ID != "3037" & kc$ID != "2036")
##update JOLs
JOLs_T = subset(JOLs_T,
JOLs_T$ID != "2003" & JOLs_T$ID != "2036")
JOLs_T$passage = str_sub(JOLs_T$Trial_Type, 1, str_length(JOLs_T$Trial_Type)-2)
JOL_T_Wide = cast(JOLs_T, ID ~ passage, value = "JOL", mean)
##get knowledge checks
apply(kc[2:5], 2, mean)
apply(kc[2:5], 2, sd)
apply(kc[2:5], 2, min)
apply(kc[2:5], 2, max)
kc.long = melt(kc,
measure.vars = c("DD", "AD", "SO", "SUN"))
colnames(kc.long)[3:4] = c("passage", "score")
m1 = ezANOVA(kc.long,
dv = score,
wid = ID,
between = encoding,
within = passage,
type = 3,
detailed = T) #no interaction w/ passage
m1
#get MSE here
m1$ANOVA$MSE = m1$ANOVA$SSd/m1$ANOVA$DFd
m1$ANOVA$MSE
aovEffectSize(m1, effectSize = "pes")
##get JOLs for table
apply(JOL_T_Wide[2:5], 2, mean)
apply(JOL_T_Wide[2:5], 2, sd)
#get final ns
term = subset(dat,
dat$encoding == "term")
read = subset(dat,
dat$encoding == "read")
length(unique(term$ID)) #45
length(unique(read$ID)) #42
####Analyses####
##between groups t-test
#get back in long format
dat.wide = cast(dat, ID ~ encoding, mean)
term2 = dat.wide[ , c(1, 3)]
read2 = dat.wide[ , c(1, 2)]
sd(term2$term, na.rm = T); sd(read2$read, na.rm = T)
#run the t-test
temp = t.test(term2$term, read2$read, paired = F, p.adjust.methods = "bonferroni", var.equal = T)
temp
round(temp$p.value, 3)
temp$statistic
(temp$conf.int[2] - temp$conf.int[1]) / 3.92 #sig!
#so, compared to silent reading, term-specific JOLs greatly increase recognition
####What ex 2 term vs ex 3 term?####
term.e2 = read.csv("Ex 2 term.csv")
term.e3 = na.omit(term2)
temp = t.test(term.e2$term, term.e3$term, paired = F, p.adjust.methods = "bonferroni", var.equal = T)
temp
round(temp$p.value, 3)
temp$statistic
(temp$conf.int[2] - temp$conf.int[1]) / 3.92 #sig!
####Descriptives####
tapply(dat$Answer, dat$encoding, mean, na.rm = T)
####What ex 2 term vs ex 3 term?####
